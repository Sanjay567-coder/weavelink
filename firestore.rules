rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to get member role
    function getRole() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role;
    }
    
    match /cooperatives/{coopId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getRole() == 'admin';
      
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
    
    match /members/{memberId} {
      allow read: if request.auth != null;
      // Allow write if Admin, OR if the user is updating their own pre-existing profile without changing their role
      allow write: if request.auth != null && (
        getRole() == 'admin' || 
        (request.auth.uid == memberId && 
         resource != null && 
         request.resource.data.role == resource.data.role)
      );
    }
    
    match /orders/{orderId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.auth != null && getRole() == 'admin';
      allow update: if (
        request.auth != null && getRole() == 'admin' &&
        (resource.data.status != 'confirmed' || request.resource.data.price == resource.data.price)
      ) || (
        // Public buyer confirmation path: allow anyone to confirm but restrict changes to ONLY buyerConfirmed and buyerConfirmedAt fields, and only if not already confirmed
        resource.data.get('buyerConfirmed', false) != true &&
        request.resource.data.buyerConfirmed == true &&
        request.resource.data.buyerConfirmedAt != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buyerConfirmed', 'buyerConfirmedAt'])
      );
      
      match /responses/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (getRole() == 'admin' || request.auth.uid == memberId);
      }
      
      match /allocations/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && getRole() == 'admin';
      }
      
      match /progress/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (getRole() == 'admin' || request.auth.uid == memberId);
      }
      
      match /payments/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (getRole() == 'admin' || getRole() == 'treasurer');
      }
    }
  }
}
