rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to get member details
    function getMemberData(uid) {
      return get(/databases/$(database)/documents/members/$(uid)).data;
    }
    
    function getRole() {
      return getMemberData(request.auth.uid).role;
    }
    
    match /cooperatives/{coopId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        getRole() == 'admin' && 
        getMemberData(request.auth.uid).coopId == coopId;
      
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          // Standard message: senderId must match authenticated user, and they must belong to this coop
          (request.resource.data.senderId == request.auth.uid && 
           getMemberData(request.auth.uid).coopId == coopId) ||
          // System message: senderId is 'system', and the write is performed by an Admin of this coop
          (request.resource.data.senderId == 'system' && 
           getRole() == 'admin' && 
           getMemberData(request.auth.uid).coopId == coopId)
        );
      }
    }
    
    match /members/{memberId} {
      allow read: if request.auth != null && (
        resource.data.coopId == getMemberData(request.auth.uid).coopId || 
        resource.data.coopId == ''
      );
      // Allow write if Admin (only if target coopId matches Admin's own coopId and resource was unassigned), 
      // OR if the user is updating their own pre-existing profile without changing their role
      allow write: if request.auth != null && (
        (getRole() == 'admin' && 
         (
           (resource == null && request.resource.data.coopId == getMemberData(request.auth.uid).coopId) ||
           (resource != null && 
            resource.data.coopId == '' &&
            request.resource.data.coopId == getMemberData(request.auth.uid).coopId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coopId', 'role']))
         )
        ) || 
        (request.auth.uid == memberId && 
         resource != null && 
         request.resource.data.role == resource.data.role)
      );
    }
    
    match /orders/{orderId} {
      allow get: if true;
      allow list: if request.auth != null;
      
      allow create: if request.auth != null && 
        getRole() == 'admin' &&
        request.resource.data.coopId == getMemberData(request.auth.uid).coopId &&
        request.resource.data.enteredBy == getMemberData(request.auth.uid).name + ' (Admin)' &&
        request.resource.data.enteredAt == request.time &&
        request.resource.data.buyerConfirmed == false;
        
      allow update: if (
        request.auth != null && getRole() == 'admin' &&
        getMemberData(request.auth.uid).coopId == resource.data.coopId &&
        (resource.data.status != 'confirmed' || request.resource.data.price == resource.data.price)
      ) || (
        // Public buyer confirmation path: allow anyone to confirm but restrict changes to ONLY buyerConfirmed and buyerConfirmedAt fields, and only if not already confirmed
        resource.data.get('buyerConfirmed', false) != true &&
        request.resource.data.buyerConfirmed == true &&
        request.resource.data.buyerConfirmedAt != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buyerConfirmed', 'buyerConfirmedAt'])
      );
      
      allow delete: if request.auth != null && 
        getRole() == 'admin' &&
        getMemberData(request.auth.uid).coopId == resource.data.coopId &&
        resource.data.status != 'confirmed';
      
      match /responses/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (getRole() == 'admin' || request.auth.uid == memberId);
      }
      
      match /allocations/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && getRole() == 'admin';
      }
      
      match /progress/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (getRole() == 'admin' || request.auth.uid == memberId);
      }
      
      match /payments/{memberId} {
        allow read: if request.auth != null && (
          (
            (getRole() == 'admin' || getRole() == 'treasurer') && 
            getMemberData(request.auth.uid).coopId == get(/databases/$(database)/documents/orders/$(orderId)).data.coopId
          ) || 
          request.auth.uid == memberId
        );
        allow write: if request.auth != null && 
          (getRole() == 'admin' || getRole() == 'treasurer') && 
          getMemberData(request.auth.uid).coopId == get(/databases/$(database)/documents/orders/$(orderId)).data.coopId;
      }
    }

    match /poolingRequests/{requestId} {
      allow read: if request.auth != null && (
        getMemberData(request.auth.uid).coopId == resource.data.fromCoopId ||
        getMemberData(request.auth.uid).coopId == resource.data.toCoopId
      );
      
      allow create: if request.auth != null &&
        getRole() == 'admin' &&
        request.resource.data.fromCoopId == getMemberData(request.auth.uid).coopId &&
        request.resource.data.status == 'pending';
        
      allow update: if request.auth != null &&
        getRole() == 'admin' &&
        getMemberData(request.auth.uid).coopId == resource.data.toCoopId &&
        (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        
      allow delete: if false;
    }
  }
}
